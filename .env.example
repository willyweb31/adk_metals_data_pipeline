# Gemini via Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html), 32 lowercase characters
FRED_API_KEY=your-fred-key

# local writes to ./output ; s3, azure or gcs write to cloud object storage
STORAGE_BACKEND=local

# --- Only for STORAGE_BACKEND=s3 ---
S3_BUCKET=your-bucket-name
AWS_REGION=us-east-2
# Option 1 (recommended): leave these unset and use `aws configure` / `aws sso login`
# Option 2: an IAM user's access key (scope it to this bucket only)
# S3_AccessKeyId=
# S3_SecretAccessKey=

# --- Only for STORAGE_BACKEND=azure ---
AZURE_STORAGE_CONTAINER=metals-pipeline
# Option 1 (recommended, no key in any file): run `az login`, then set the account
AZURE_STORAGE_ACCOUNT=yourstorageaccount
# Option 2: connection string from Portal > Storage account > Access keys
# AZURE_STORAGE_CONNECTION_STRING=

# --- Only for STORAGE_BACKEND=gcs (auth: gcloud auth application-default login) ---
GCS_BUCKET=your-bucket-name
GOOGLE_CLOUD_PROJECT=your-project-id

ADK_MODEL=gemini-flash-lite-latest
