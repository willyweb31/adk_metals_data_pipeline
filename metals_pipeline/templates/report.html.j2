<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Metals Price Dashboard</title>
<style>
  :root {
    --bg: #f7f7f5; --panel: #ffffff; --ink: #1d1f23; --muted: #5d636e;
    --line: #e3e4e8; --accent: #2f6fdb; --up: #b4532a; --down: #2c7a5b;
    --ai-bg: #eef3fc; --ai-line: #c9d8f4;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #15171b; --panel: #1d2026; --ink: #e8e9ec; --muted: #a0a6b1;
      --line: #2e323a; --accent: #7aa7f5; --up: #e08a62; --down: #5fc29a;
      --ai-bg: #1b2433; --ai-line: #2d3d58;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 48px; }
  header h1 { margin: 0 0 4px; font-size: 26px; letter-spacing: -0.01em; }
  .meta { color: var(--muted); font-size: 13px; display: flex; flex-wrap: wrap; gap: 4px 16px; }
  section { background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
            padding: 18px 20px; margin-top: 18px; }
  h2 { font-size: 16px; margin: 0 0 4px; }
  .sub { color: var(--muted); font-size: 13px; margin: 0 0 12px; }
  .ai { background: var(--ai-bg); border-color: var(--ai-line); }
  .ai .tag { display: inline-block; font-size: 11px; font-weight: 600; letter-spacing: .04em;
             text-transform: uppercase; color: var(--accent); margin-bottom: 6px; }
  .ai .headline { font-size: 17px; font-weight: 600; margin: 0 0 8px; }
  .ai ul { margin: 0; padding-left: 20px; }
  .ai li { margin: 4px 0; }
  .grid { display: grid; grid-template-columns: 3fr 2fr; gap: 18px; }
  .grid section { margin-top: 18px; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; gap: 0; } }
  .chart { position: relative; height: 340px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 12px; }
  .card { border: 1px solid var(--line); border-radius: 8px; padding: 12px 14px 8px; min-width: 0; }
  .card .name { font-size: 13px; color: var(--muted); font-weight: 600; }
  .card .price { font-size: 22px; font-weight: 700; letter-spacing: -0.01em; margin: 2px 0 0; }
  .card .unit { font-size: 11.5px; color: var(--muted); }
  .card .chg { font-size: 12.5px; margin-top: 4px; }
  .card .spark { position: relative; height: 70px; margin-top: 6px; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { padding: 8px 10px; border-bottom: 1px solid var(--line); text-align: right; white-space: nowrap; }
  th:first-child, td:first-child { text-align: left; white-space: normal; }
  th { font-size: 12px; color: var(--muted); font-weight: 600; }
  td .id { display: block; color: var(--muted); font-size: 12px; }
  .pos { color: var(--up); } .neg { color: var(--down); }
  footer { color: var(--muted); font-size: 12px; margin-top: 22px; }
  footer code { font-size: 11.5px; word-break: break-all; }
  footer ul { margin: 4px 0 10px; padding-left: 18px; }
</style>
</head>
<body>
<main>
  <header>
    <h1>Metals Price Dashboard</h1>
    <div class="meta">
      <span>Data through <strong>{{ data_through }}</strong></span>
      <span>Run <code>{{ summary.run_id }}</code></span>
      <span>Sources: U.S. Bureau of Labor Statistics producer price indexes and IMF global commodity prices, via FRED (Federal Reserve Bank of St. Louis)</span>
    </div>
  </header>

  <section class="ai" aria-labelledby="ai-h">
    <span class="tag">AI-generated commentary</span>
    <h2 id="ai-h" class="headline">{{ commentary.headline }}</h2>
    <ul>
      {% for b in commentary.bullets %}
      <li>{{ b }}</li>
      {% endfor %}
    </ul>
    <p class="sub" style="margin:10px 0 0">Written by the analyst agent from the computed figures in <code>latest.csv</code> only. Check against the table below before relying on it.</p>
  </section>

  {% if market_rows %}
  <section aria-labelledby="m-h">
    <h2 id="m-h">Market prices (U.S. dollars per metric ton)</h2>
    <p class="sub">IMF monthly global prices{% if market_through %}, latest {{ market_through }}{% endif %}. Change vs. the prior month and the same month a year earlier. Each chart has its own dollar scale.</p>
    <div class="cards">
      {% for r in market_rows %}
      <div class="card">
        <div class="name">{{ r.label }}</div>
        <div class="price">{{ r.value | usd }}</div>
        <div class="unit">{{ r.units or "U.S. dollars per metric ton" }} · {{ r.as_of[:7] }}</div>
        <div class="chg">
          <span class="{{ 'pos' if (r.mom_change or 0) > 0 else 'neg' if (r.mom_change or 0) < 0 }}">MoM {{ r.mom_change | usd(True) }} ({{ r.mom_pct | fmt(2, True) }}%)</span><br>
          <span class="{{ 'pos' if (r.yoy_pct or 0) > 0 else 'neg' if (r.yoy_pct or 0) < 0 }}">YoY {{ r.yoy_change | usd(True) }} ({{ r.yoy_pct | fmt(1, True) }}%)</span>
        </div>
        <div class="spark"><canvas id="spark-{{ r.series_id }}" role="img" aria-label="{{ r.label }} price in dollars per metric ton over time"></canvas></div>
      </div>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <div class="grid">
    <section aria-labelledby="c1-h">
      <h2 id="c1-h">Producer price indexes, rebased</h2>
      <p class="sub">Each series = 100 in {{ base_month_label }}, so different index bases compare on one scale.</p>
      <div class="chart"><canvas id="lineChart" role="img" aria-label="Line chart of rebased metals price indexes"></canvas></div>
    </section>
    <section aria-labelledby="c2-h">
      <h2 id="c2-h">Year-over-year change</h2>
      <p class="sub">Latest month vs. the same month a year earlier, %, for market prices and indexes.</p>
      <div class="chart"><canvas id="barChart" role="img" aria-label="Bar chart of year-over-year percent change by series"></canvas></div>
    </section>
  </div>

  {% if market_rows %}
  <section aria-labelledby="tm-h">
    <h2 id="tm-h">Latest market prices ($ per metric ton)</h2>
    <p class="sub">Sorted by YoY change. Volatility is the 12-month standard deviation of monthly % changes (percentage points).</p>
    <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Metal</th><th>As of</th><th>Price</th><th>MoM $</th><th>MoM %</th><th>YoY $</th><th>YoY %</th><th>12m vol</th><th>5y high</th><th>5y low</th></tr>
      </thead>
      <tbody>
        {% for r in market_rows %}
        <tr>
          <td>{{ r.label }}<span class="id">{{ r.series_id }}</span></td>
          <td>{{ r.as_of[:7] }}</td>
          <td>{{ r.value | usd }}</td>
          <td class="{{ 'pos' if (r.mom_change or 0) > 0 else 'neg' if (r.mom_change or 0) < 0 }}">{{ r.mom_change | usd(True) }}</td>
          <td class="{{ 'pos' if (r.mom_pct or 0) > 0 else 'neg' if (r.mom_pct or 0) < 0 }}">{{ r.mom_pct | fmt(2, True) }}</td>
          <td class="{{ 'pos' if (r.yoy_change or 0) > 0 else 'neg' if (r.yoy_change or 0) < 0 }}">{{ r.yoy_change | usd(True) }}</td>
          <td class="{{ 'pos' if (r.yoy_pct or 0) > 0 else 'neg' if (r.yoy_pct or 0) < 0 }}">{{ r.yoy_pct | fmt(1, True) }}</td>
          <td>{{ r.vol_12m | fmt(2) }}</td>
          <td>{{ r.high_5y | usd }}</td>
          <td>{{ r.low_5y | usd }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  </section>
  {% endif %}

  {% if ppi_rows %}
  <section aria-labelledby="t-h">
    <h2 id="t-h">Latest producer price indexes</h2>
    <p class="sub">Index levels, not dollars. Sorted by YoY change. Volatility is the 12-month standard deviation of monthly % changes (percentage points).</p>
    <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Series</th><th>As of</th><th>Index</th><th>MoM %</th><th>YoY %</th><th>12m vol</th><th>5y high</th><th>5y low</th></tr>
      </thead>
      <tbody>
        {% for r in ppi_rows %}
        <tr>
          <td>{{ r.label }}<span class="id">{{ r.series_id }}</span></td>
          <td>{{ r.as_of[:7] }}</td>
          <td>{{ r.value | fmt(1) }}</td>
          <td class="{{ 'pos' if (r.mom_pct or 0) > 0 else 'neg' if (r.mom_pct or 0) < 0 }}">{{ r.mom_pct | fmt(2, True) }}</td>
          <td class="{{ 'pos' if (r.yoy_pct or 0) > 0 else 'neg' if (r.yoy_pct or 0) < 0 }}">{{ r.yoy_pct | fmt(1, True) }}</td>
          <td>{{ r.vol_12m | fmt(2) }}</td>
          <td>{{ r.high_5y | fmt(1) }}</td>
          <td>{{ r.low_5y | fmt(1) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
  </section>
  {% endif %}

  <footer>
    <div>Quality checks passed: <strong>{{ checks_passed }}/{{ checks_total }}</strong> · google-adk {{ adk_version }} · generated {{ generated_at }}</div>
    <div>Storage: <code>{{ storage_location }}</code></div>
    <div>Raw files:</div>
    <ul>{% for p in object_paths.raw %}<li><code>{{ p }}</code></li>{% endfor %}</ul>
    <div>Processed files:</div>
    <ul>{% for name, p in object_paths.processed.items() %}<li><code>{{ p }}</code></li>{% endfor %}</ul>
    <div>Run manifest: <code>{{ object_paths.manifest }}</code></div>
  </footer>
</main>

<script type="application/json" id="chart-data">{{ data_json | safe }}</script>
<script src="{{ chart_js_url }}"></script>
<script>
(function () {
  var data = JSON.parse(document.getElementById("chart-data").textContent);
  if (typeof Chart === "undefined") {
    document.querySelectorAll(".chart").forEach(function (el) {
      el.innerHTML = "<p class='sub'>Charts need an internet connection to load Chart.js.</p>";
    });
    return;
  }
  var css = getComputedStyle(document.documentElement);
  var v = function (n) { return css.getPropertyValue(n).trim(); };
  var palette = ["#2f6fdb", "#d1663a", "#2c9a6f", "#8a5cd1", "#c9a227", "#d14d82"];
  Chart.defaults.color = v("--muted");
  Chart.defaults.borderColor = v("--line");
  Chart.defaults.font.family = getComputedStyle(document.body).fontFamily;

  var usd = function (x) {
    return x == null ? "n/a" : "$" + x.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  };
  var usdShort = function (x) {
    return x >= 1000 ? "$" + (x / 1000).toFixed(x >= 10000 ? 0 : 1) + "k" : "$" + Math.round(x);
  };
  (data.market || []).forEach(function (m, i) {
    var el = document.getElementById("spark-" + m.id);
    if (!el) return;
    var color = palette[i % palette.length];
    // Fit the scale to the data (not $0) so each metal's movement is visible.
    var vals = m.data.filter(function (x) { return x != null; });
    var lo = Math.min.apply(null, vals), hi = Math.max.apply(null, vals), pad = (hi - lo) * 0.08 || hi * 0.05;
    new Chart(el, {
      type: "line",
      data: { labels: m.months, datasets: [{ data: m.data, borderColor: color, backgroundColor: color,
               borderWidth: 1.5, pointRadius: 0, pointHoverRadius: 2, tension: 0.15, spanGaps: false }] },
      options: {
        maintainAspectRatio: false,
        interaction: { mode: "index", intersect: false },
        plugins: { legend: { display: false },
          tooltip: { callbacks: { label: function (c) { return usd(c.parsed.y) + " / t"; } } } },
        scales: {
          x: { display: false },
          y: { min: Math.max(0, lo - pad), max: hi + pad, ticks: { count: 3, font: { size: 10 }, callback: function (val) { return usdShort(val); } },
               grid: { color: v("--line") } }
        }
      }
    });
  });

  if (data.lines.length) new Chart(document.getElementById("lineChart"), {
    type: "line",
    data: {
      labels: data.months,
      datasets: data.lines.map(function (s, i) {
        return { label: s.label, data: s.data, borderColor: palette[i % palette.length],
                 backgroundColor: palette[i % palette.length], borderWidth: 2,
                 pointRadius: 0, pointHoverRadius: 3, tension: 0.15, spanGaps: false };
      })
    },
    options: {
      maintainAspectRatio: false,
      interaction: { mode: "index", intersect: false },
      plugins: {
        legend: { position: "bottom", labels: { boxWidth: 12, boxHeight: 2 } },
        tooltip: { callbacks: { label: function (c) {
          return c.dataset.label + ": " + (c.parsed.y == null ? "n/a" : c.parsed.y.toFixed(1)); } } }
      },
      scales: {
        x: { title: { display: true, text: "Month" }, ticks: { maxTicksLimit: 10 } },
        y: { title: { display: true, text: "Index (" + data.base_month + " = 100)" } }
      }
    }
  });

  new Chart(document.getElementById("barChart"), {
    type: "bar",
    data: {
      // Market prices are tagged "($)" so they read apart from the indexes.
      labels: data.bars.map(function (b) { return b.label + (b.kind === "market" ? " ($)" : ""); }),
      datasets: [{
        label: "YoY %",
        data: data.bars.map(function (b) { return b.yoy; }),
        backgroundColor: data.bars.map(function (b) { return b.yoy >= 0 ? v("--up") : v("--down"); }),
        borderRadius: 3
      }]
    },
    options: {
      indexAxis: "y",
      maintainAspectRatio: false,
      plugins: { legend: { display: false },
        tooltip: { callbacks: {
          title: function (items) { return items[0].label; },
          label: function (c) { return (c.parsed.x >= 0 ? "+" : "") + c.parsed.x.toFixed(1) + "%"; } } } },
      scales: {
        x: { title: { display: true, text: "YoY change (%)" },
             grid: { color: function (c) { return c.tick.value === 0 ? v("--muted") : v("--line"); } } },
        y: { ticks: { autoSkip: false, callback: function (val) {
               var t = this.getLabelForValue(val);
               return t.length > 26 ? t.slice(0, 24) + "…" : t; } } }
      }
    }
  });
})();
</script>
</body>
</html>
